name = "myscheduler"
compatibility_date = "2026-01-03"

pages_build_output_dir = "./dist"

# This is a Pages project, not a Worker
# Pages will automatically deploy after build - no deploy command needed

# D1 Database for user accounts
[[d1_databases]]
binding = "DB"
database_name = "focusboard-db"
database_id = "2ce24068-cc3a-4afc-8e6d-2e43936ff608"

# No environment variables needed - using session-based auth with cookies
